# Replace YOUR_PASSWORD with the password you set when installing PostgreSQL.
# Replace postgres with your DB user if you use a different superuser name.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tcg_storefront?schema=public"

# Optional: live market prices from JustTCG (https://justtcg.com/docs)
# JUSTTCG_API_KEY=

# Used by `npm run admin:create`. Choose a unique password of at least 12 characters.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Shopify Headless Storefront API (never prefix the private token with NEXT_PUBLIC_).
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_PRIVATE_TOKEN="replace-with-your-private-token"
SHOPIFY_STOREFRONT_PUBLIC_TOKEN="replace-with-your-public-token"

# Server-only Shopify Admin API credentials for your Dev Dashboard app.
SHOPIFY_ADMIN_CLIENT_ID="replace-with-your-client-id"
SHOPIFY_ADMIN_CLIENT_SECRET="replace-with-your-client-secret"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHOPIFY_CART_COOKIE_SECRET="replace-with-a-random-32-byte-base64url-value"
