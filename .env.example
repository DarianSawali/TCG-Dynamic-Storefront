# Replace YOUR_PASSWORD with the password you set when installing PostgreSQL.
# Replace postgres with your DB user if you use a different superuser name.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tcg_storefront?schema=public"

# Optional: live market prices from JustTCG (https://justtcg.com/docs)
# JUSTTCG_API_KEY=

# Used by `npm run admin:create`. Choose a unique password of at least 12 characters.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
