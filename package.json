{
  "name": "shopify-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:fetch-sets": "tsx scripts/fetch-tcgdex-sets.ts",
    "shopify:check": "tsx scripts/check-shopify.ts",
    "shopify:check-product": "tsx scripts/check-shopify-product.ts",
    "shopify:check-admin": "tsx scripts/check-shopify-admin.ts",
    "pricing:check-policy": "tsx scripts/check-pricing-policy.ts",
    "pricing:check-observations": "tsx scripts/check-price-observations.ts",
    "pricing:sync-catalog": "tsx scripts/sync-justtcg-catalog-prices.ts",
    "pricing:observe": "node --conditions=react-server --import tsx scripts/record-price-observations.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "justtcg-js": "^0.1.26",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
